<Window x:Class="Lab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Облік співробітників"
        Height="900"
        Width="950"
        MinHeight="650"
        MinWidth="850"
        Background="#F2F2F2"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#B71C1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#252525"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid Grid.Row="1" Margin="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="Новий співробітник"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="0,0,0,18"/>
                    <TextBlock Text="Тип співробітника"/>
                    <ComboBox x:Name="EmployeeTypeComboBox"
                              SelectionChanged="EmployeeTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Програміст"/>
                        <ComboBoxItem Content="Дизайнер"/>
                        <ComboBoxItem Content="Менеджер"/>
                    </ComboBox>
                    <TextBlock Text="Посада"/>
                    <TextBox x:Name="PositionTextBox"/>
                    <TextBlock Text="Стаж"/>
                    <TextBox x:Name="ExperienceTextBox"/>
                    <TextBlock Text="Зарплата за годину"/>
                    <TextBox x:Name="HourlyRateTextBox"/>
                    <TextBlock Text="Відпрацьовані години"/>
                    <TextBox x:Name="HoursTextBox"/>
                    <TextBlock Text="Назва проєкту"/>
                    <TextBox x:Name="ProjectTextBox"/>
                    <Button Content="+ ДОДАТИ ПРОЄКТ"
                            Click="AddProjectButton_Click"/>
                    <ListBox x:Name="ProjectsListBox"
                             Height="70"/>
                    <TextBlock x:Name="AdditionalFieldLabel"
                               Text="Рівень"/>
                    <ComboBox x:Name="LevelComboBox">
                        <ComboBoxItem Content="Junior"/>
                        <ComboBoxItem Content="Senior"/>
                    </ComboBox>
                    <ComboBox x:Name="SpecializationComboBox"
                              Visibility="Collapsed">
                        <ComboBoxItem Content="UI/UX"/>
                        <ComboBoxItem Content="Вебдизайн"/>
                        <ComboBoxItem Content="Графічний дизайн"/>
                    </ComboBox>
                    <TextBox x:Name="TeamSizeTextBox"
                              Visibility="Collapsed"/>
                    <Button Content="+  ДОДАТИ СПІВРОБІТНИКА"
                            Click="AddEmployeeButton_Click"
                            Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Список співробітників"
                                   FontSize="19"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Додані працівники та їхня місячна зарплата"
                                   Foreground="#777777"
                                   FontSize="12"
                                   Margin="0,4,0,15"/>
                    </StackPanel>
                    <ListBox x:Name="EmployeesListBox"
                             Grid.Row="1"
                             BorderBrush="#DDDDDD"
                             BorderThickness="1"
                             FontSize="14"
                             Padding="5"/>
                    <Border Grid.Row="2"
                            Background="#F4F4F4"
                            CornerRadius="5"
                            Margin="0,18,0,0"
                            Padding="15">
                        <StackPanel>
                            <TextBlock Text="ЗАГАЛЬНИЙ ФОНД ЗАРПЛАТИ"
                                       Foreground="#777777"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="TotalSalaryTextBlock"
                                       Text="0 грн"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>